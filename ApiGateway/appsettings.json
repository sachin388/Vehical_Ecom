{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "ApiGateway",
    "ServiceVersion": "1.0.0",
    "Environment": "Development",
    "OtlpEndpoint": "http://localhost:8200",
    "OtlpProtocol": "HttpProtobuf",
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogging": true,
    "CaptureSqlStatements": true
  },
  "Jwt": {
    "Issuer": "VehicleEcommerce.Auth",
    "Audience": "VehicleEcommerce.Api",
    "SecretKey": "6XNealH/7HrldBMPZ4T/cNiQnxsTz/N1eOPrfOKN+05uTquaBKTBqgcAeq/N5QJPveDAqe1QuckyAP1jef2gKg=="
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:4173",
      "http://localhost:8080"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 60,
    "QueueLimit": 50
