      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed-window",
        "CorsPolicy": "DefaultCorsPolicy",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-Gateway", "Set": "YARP-VehicleEcommerce" }
        ]
      },
      "items-route": {
        "ClusterId": "items-cluster",
        "RateLimiterPolicy": "fixed-window",
