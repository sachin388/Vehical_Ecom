{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "ServiceName": "NotificationSystem.API",
    "ServiceVersion": "1.0.0",
    "Environment": "Development",
    "OtlpEndpoint": "http://localhost:8200",
    "OtlpProtocol": "HttpProtobuf",
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogging": true,
    "CaptureSqlStatements": true
  },
  "AllowedHosts": "*"
}
